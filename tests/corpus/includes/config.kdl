// Main file of the include corpus.
input {
    keyboard { xkb { layout "fi"; }; numlock; }
    touchpad { tap; natural-scroll; }
}

layout {
    gaps 12 // trailing comment
    center-focused-column "on-overflow"
    /- always-center-single-column
    struts { top 8; bottom 8; }
    border { off; width 2; }
    focus-ring {
        width 3
        active-color "#7fc8ff"
    }
    preset-column-widths { proportion 0.25; proportion 0.5; fixed 1200; }
    default-column-width { proportion 0.5; }
}

output "DP-1" {
    scale 1.5
    layout { gaps 4; }
}

include "colors.kdl"
window-rule { match app-id=r#"^org\.gnome\."#; open-floating true; }
include "sub/binds.kdl"
include optional=true "missing.kdl"

/* block
   comment */
prefer-no-csd
spawn-at-startup "waybar" \
    "--log-level" "debug"
